{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint . && tsc --noEmit && prettier --check './**/*.{ts,tsx}' && knip && syncpack lint",
    "lint:fix": "eslint . --fix && prettier --write './**/*.{ts,tsx}'",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:cov:diff": "jest --coverage && python3 ../tools/diff_coverage_ts.py coverage/lcov.info",
    "test:single": "jest",
    "generate": "buf generate",
    "generate:check": "npm run generate && (git diff --exit-code lib/gen/ || (echo \"lib/gen/ is out of date -- run 'npm run generate' (web) and 'make proto/generate' (api), then commit the results.\" && exit 1))"
  },
  "dependencies": {
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-web": "2.1.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@sentry/nextjs": "10.72.0",
    "clsx": "2.1.1",
    "dompurify": "3.4.14",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-reader": "2.0.15",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.6.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "knip": "6.32.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "react-is": "19.2.8",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.68.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "js-yaml": "3.15.1",
    "fast-uri": "3.1.6",
    "brace-expansion": "5.0.9",
    "@babel/core": "7.29.7",
    "ws": "8.21.3",
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": "24.x"
  }
}
