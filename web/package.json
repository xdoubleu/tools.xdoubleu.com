{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.mjs && vite build",
    "dev": "node scripts/generate-icons.mjs && vite",
    "lint": "eslint . && npm run test:eslint-rules && tsc --noEmit && prettier --check './**/*.{ts,tsx}' && knip && syncpack lint && npm run generate:ui-catalog:check && npm run arch:check",
    "lint:fix": "eslint . --fix && prettier --write './**/*.{ts,tsx}'",
    "arch:check": "depcruise app components hooks lib src --config .dependency-cruiser.cjs",
    "arch:diagram": "depcruise app components hooks lib src --config .dependency-cruiser.cjs --output-type mermaid --collapse \"^(app|components|lib|hooks|src)/[^/]+\" --exclude \"^node_modules\"",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:eslint-rules": "node --test 'eslint-rules/*.test.mjs'",
    "test:cov:diff": "vitest run --coverage && python3 ../tools/diff_coverage_ts.py coverage/lcov.info",
    "test:single": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:diff": "bash scripts/test-mutation-diff.sh",
    "generate": "buf generate",
    "generate:local": "command -v buf >/dev/null 2>&1 || { echo \"buf not found on PATH -- run 'make tools/proto/local' (api/) and add \\$(go env GOPATH)/bin to PATH\" >&2; exit 1; }; buf generate --template buf.gen.local.yaml",
    "generate:check": "npm run generate && (git diff --exit-code lib/gen/ || (echo \"lib/gen/ is out of date -- run 'npm run generate' (web) and 'make proto/generate' (api), then commit the results.\" && exit 1))",
    "mobile:audit": "node scripts/mobile-audit.mjs",
    "generate:ui-catalog": "node scripts/generate-ui-catalog.mjs",
    "generate:ui-catalog:check": "npm run generate:ui-catalog && (git diff --exit-code components/ui/README.md || (echo \"components/ui/README.md is out of date -- run 'npm run generate:ui-catalog' and commit the result.\" && exit 1))"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@readium/navigator": "2.13.2",
    "@readium/shared": "2.8.0",
    "@sentry/react": "11.8.0",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "pdfjs-dist": "6.4.299",
    "posthog-js": "1.438.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "11.8.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "knip": "6.42.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@readium/shared": "2.8.0",
    "brace-expansion": "5.0.12",
    "@babel/core": "7.29.7",
    "@stryker-mutator/instrumenter": {
      "@babel/core": "8.0.6"
    },
    "browserslist": "4.29.4",
    "baseline-browser-mapping": "2.11.31",
    "postcss-selector-parser": "7.1.7",
    "qs": "6.16.1"
  },
  "engines": {
    "node": "24.x"
  }
}
