{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint . && tsc --noEmit && prettier --check './**/*.{ts,tsx}' && knip && syncpack lint && npm run generate:ui-catalog:check && npm run arch:check",
    "lint:fix": "eslint . --fix && prettier --write './**/*.{ts,tsx}'",
    "arch:check": "depcruise app components hooks lib --config .dependency-cruiser.js",
    "arch:diagram": "depcruise app components hooks lib --config .dependency-cruiser.js --output-type mermaid --collapse \"^(app|components|lib|hooks)/[^/]+\" --exclude \"^node_modules\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:cov:diff": "jest --coverage && python3 ../tools/diff_coverage_ts.py coverage/lcov.info",
    "test:single": "jest",
    "test:mutation": "stryker run",
    "test:mutation:diff": "bash scripts/test-mutation-diff.sh",
    "generate": "buf generate",
    "generate:local": "command -v buf >/dev/null 2>&1 || { echo \"buf not found on PATH -- run 'make tools/proto/local' (api/) and add \\$(go env GOPATH)/bin to PATH\" >&2; exit 1; }; buf generate --template buf.gen.local.yaml",
    "generate:check": "npm run generate && (git diff --exit-code lib/gen/ || (echo \"lib/gen/ is out of date -- run 'npm run generate' (web) and 'make proto/generate' (api), then commit the results.\" && exit 1))",
    "mobile:audit": "node scripts/mobile-audit.mjs",
    "generate:ui-catalog": "node scripts/generate-ui-catalog.mjs",
    "generate:ui-catalog:check": "npm run generate:ui-catalog && (git diff --exit-code components/ui/README.md || (echo \"components/ui/README.md is out of date -- run 'npm run generate:ui-catalog' and commit the result.\" && exit 1))"
  },
  "dependencies": {
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@sentry/nextjs": "10.75.2",
    "clsx": "2.1.1",
    "dompurify": "3.4.15",
    "next": "16.3.6",
    "posthog-js": "1.434.10",
    "prom-client": "15.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-reader": "2.0.15",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "knip": "6.37.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "react-is": "19.3.0",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.70.1"
  },
  "overrides": {
    "nanoid": "6.0.1",
    "js-yaml": "5.4.2",
    "fast-uri": "4.2.1",
    "brace-expansion": "5.0.12",
    "@babel/core": "7.29.7",
    "ws": "8.21.3",
    "@xmldom/xmldom": "0.9.12",
    "browserslist": "4.29.0",
    "baseline-browser-mapping": "2.11.25",
    "qs": "6.16.0"
  },
  "engines": {
    "node": "24.x"
  }
}
