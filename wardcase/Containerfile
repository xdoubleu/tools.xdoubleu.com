# The wardcase base image (docs/adr-0055): one per release, tagged with the
# release's version, for any repository. It holds the harnesses, git and Nix, and
# nothing of a project's own: a checkout's tools come from its flake.nix dev shell,
# and skills from a host cache mounted at run time, never from here. Runs as the
# unprivileged `node` user (uid 1000). Build from the repo root:
#   container build -f wardcase/Containerfile -t ghcr.io/xdoubleu/wardcase:<version> .
FROM docker.io/library/node:26-bookworm-slim@sha256:0042e17d232a87a2cd485be1da7900fca4d10a4ad11b29e9285da1d2e54798c9

ARG CLAUDE_CODE_VERSION=2.1.285
# Only @opencode/cli: the `opencode-ai` package ships the same binary name.
ARG OPENCODE_VERSION=2.2.2
ARG CODEX_VERSION=0.140.0
# The ACP adapter that drives Codex for a chat (adr-0060).
ARG CODEX_ACP_VERSION=0.9.0
ARG GEMINI_CLI_VERSION=0.40.0
ARG NIX_VERSION=2.24.10
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git jq xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm install -g "@opencode/cli@${OPENCODE_VERSION}" \
    && npm install -g "@openai/codex@${CODEX_VERSION}" \
    && npm install -g "@zed-industries/codex-acp@${CODEX_ACP_VERSION}" \
    && npm install -g "@google/gemini-cli@${GEMINI_CLI_VERSION}"

# Nix (single-user, /nix owned by the job user). wardcase mounts a shared store
# over /nix, which hides this install, so it is kept at /opt/nix-seed and copied
# into an empty store by the first session. The install's profile lives under
# /home/node, so profiles/default is linked to its /nix/store path.
# /opt/claude-config is Claude's config seed (vm.ClaudeConfigSeed), empty here;
# the host skills cache mounts over it.
RUN mkdir -m 0755 /nix /etc/nix /opt/claude-config \
    && echo 'experimental-features = nix-command flakes' > /etc/nix/nix.conf \
    && chown node:node /nix /opt/claude-config
USER node
RUN case "${TARGETARCH}" in amd64) a=x86_64 ;; arm64) a=aarch64 ;; *) exit 1 ;; esac \
    && d="nix-${NIX_VERSION}-${a}-linux" \
    && curl -fsSL -o "/tmp/${d}.tar.xz" "https://releases.nixos.org/nix/nix-${NIX_VERSION}/${d}.tar.xz" \
    && tar -xJf "/tmp/${d}.tar.xz" -C /tmp \
    && "/tmp/${d}/install" --no-daemon \
    && rm -rf /tmp/nix-* \
    && ln -s "$(readlink -f /home/node/.nix-profile)" /nix/var/nix/profiles/default
USER root
RUN mv /nix /opt/nix-seed && mkdir -m 0755 /nix && chown node:node /nix
USER node
ENV PATH=/nix/var/nix/profiles/default/bin:$PATH
WORKDIR /work
