# Kamal reads this as a shell script and pulls referenced values from your
# local environment — same convention as infra/'s tfvars (see
# infra/README.md): export everything below before running `kamal deploy`,
# nothing is generated or stored here. Never commit real values.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Deploy-time SHA (git rev-parse HEAD, or the commit being deployed) — see
# config/deploy.yml's comment on RELEASE.
RELEASE=$RELEASE

DB_DSN=$DB_DSN
GOTRUE_URL=$GOTRUE_URL
SUPABASE_PROJ_REF=$SUPABASE_PROJ_REF
SUPABASE_API_KEY=$SUPABASE_API_KEY
STEAM_API_KEY=$STEAM_API_KEY
HARDCOVER_API_KEY=$HARDCOVER_API_KEY
R2_ACCOUNT_ID=$R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
R2_BUCKET=$R2_BUCKET
SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN_WEB=$SENTRY_DSN_WEB
SUPABASE_URL=$SUPABASE_URL
SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET
SENTRY_OAUTH_CLIENT_ID=$SENTRY_OAUTH_CLIENT_ID
SENTRY_OAUTH_CLIENT_SECRET=$SENTRY_OAUTH_CLIENT_SECRET
DO_OAUTH_CLIENT_ID=$DO_OAUTH_CLIENT_ID
DO_OAUTH_CLIENT_SECRET=$DO_OAUTH_CLIENT_SECRET
ENCRYPTION_KEY=$ENCRYPTION_KEY
RESEND_API_KEY=$RESEND_API_KEY
EMAIL_FROM=$EMAIL_FROM
NOTIFY_EMAIL_TO=$NOTIFY_EMAIL_TO
EMAIL_INBOUND_DOMAIN=$EMAIL_INBOUND_DOMAIN
EMAIL_INBOUND_SECRET=$EMAIL_INBOUND_SECRET

# Accessory secrets (postgres/gotrue) — same values infra/'s
# null_resource.postgres generated into the VPS's /home/deploy/postgres/.env;
# reuse them rather than rotating (tofu output -raw postgres_password, and
# the gotrue_* tfvars from infra/terraform.tfvars).
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
GOTRUE_JWT_SECRET=$GOTRUE_JWT_SECRET
GOTRUE_DB_DATABASE_URL=$GOTRUE_DB_DATABASE_URL
GOTRUE_SMTP_PASS=$GOTRUE_SMTP_PASS
GOTRUE_SITE_URL=$GOTRUE_SITE_URL
GOTRUE_SMTP_ADMIN_EMAIL=$GOTRUE_SMTP_ADMIN_EMAIL
API_EXTERNAL_URL=$API_EXTERNAL_URL
