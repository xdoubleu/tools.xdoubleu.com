# Kamal reads this as a shell script and pulls referenced values from the
# environment it runs in. That environment is .github/workflows/main.yml's
# deploy-kamal job, whose `env:` block maps a repo Secret to each name below
# — repo Secrets are the single source of truth for these. For a manual
# deploy, export the same names in your own shell first. Nothing is
# generated or stored here. Never commit real values.
#
# Shared by both `kamal deploy -c config/deploy.api.yml` and
# `-c config/deploy.web.yml` (#1038's two-service split) — each config's own
# `env.secret` list only pulls the names it actually references, so defining
# the full union here (api-only and web-only alike) is harmless.
#
# KAMAL_REGISTRY_PASSWORD is required by Kamal's own config schema even
# though both ghcr.io/xdoubleu/tools.xdoubleu.com/api and .../web are public
# GHCR packages needing no auth to actually pull — confirmed via
# `kamal config`.

RELEASE=$RELEASE
DB_DSN=$DB_DSN
GOTRUE_URL=$GOTRUE_URL
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SUPABASE_PROJ_REF=$SUPABASE_PROJ_REF
SUPABASE_API_KEY=$SUPABASE_API_KEY
STEAM_API_KEY=$STEAM_API_KEY
HARDCOVER_API_KEY=$HARDCOVER_API_KEY
R2_ACCOUNT_ID=$R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
R2_BUCKET=$R2_BUCKET
SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN_WEB=$SENTRY_DSN_WEB
SUPABASE_URL=$SUPABASE_URL
SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET
SENTRY_OAUTH_CLIENT_ID=$SENTRY_OAUTH_CLIENT_ID
SENTRY_OAUTH_CLIENT_SECRET=$SENTRY_OAUTH_CLIENT_SECRET
DO_OAUTH_CLIENT_ID=$DO_OAUTH_CLIENT_ID
DO_OAUTH_CLIENT_SECRET=$DO_OAUTH_CLIENT_SECRET
ENCRYPTION_KEY=$ENCRYPTION_KEY
RESEND_API_KEY=$RESEND_API_KEY
EMAIL_FROM=$EMAIL_FROM
NOTIFY_EMAIL_TO=$NOTIFY_EMAIL_TO
EMAIL_INBOUND_DOMAIN=$EMAIL_INBOUND_DOMAIN
EMAIL_INBOUND_SECRET=$EMAIL_INBOUND_SECRET

# No accessory secrets here — Postgres/GoTrue stay entirely OpenTofu-managed
# (infra/postgres-compose.yml); DB_DSN/GOTRUE_URL above are the only bridge
# to them. Their own secrets (POSTGRES_PASSWORD, GOTRUE_JWT_SECRET, etc.)
# live solely in infra/'s tfvars and the VPS's /home/deploy/postgres/.env,
# not here. (DB_DSN's own value is a repo Secret, KAMAL_DB_DSN, copied once
# from `tofu output -raw postgres_password` — see the template's comment.)
