# Kamal reads this as a shell script and pulls referenced values from the
# environment it runs in. That environment is .github/workflows/main.yml's
# deploy-kamal job, whose `env:` block maps a repo Secret to each name below
# — repo Secrets are the single source of truth for these. For a manual
# deploy, export the same names in your own shell first. Nothing is
# generated or stored here. Never commit real values.
#
# Shared by both `kamal deploy -c config/deploy.api.yml` and
# `-c config/deploy.web.yml` (#1038's two-service split) — each config's own
# `env.secret` list only pulls the names it actually references, so defining
# the full union here (api-only and web-only alike) is harmless.
#
# KAMAL_REGISTRY_PASSWORD is required by Kamal's own config schema even
# though ghcr.io/xdoubleu/tools.xdoubleu.com/{api,web,grafana} (issue #1509
# added grafana to this list) are all public GHCR packages needing no auth
# to actually pull — confirmed via `kamal config`.

RELEASE=$RELEASE
DB_DSN=$DB_DSN
JWT_SECRET=$JWT_SECRET
OAUTH_HMAC_SECRET=$OAUTH_HMAC_SECRET
OAUTH_OIDC_PRIVATE_KEY=$OAUTH_OIDC_PRIVATE_KEY
OAUTH_GRAFANA_CLIENT_SECRET=$OAUTH_GRAFANA_CLIENT_SECRET
# Grafana-only (issue #1468) — see config/deploy.grafana.yml's env.secret
# comments for what each of these feeds.
#
# GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET is the same value as
# OAUTH_GRAFANA_CLIENT_SECRET above (both come from the one
# OAUTH_GRAFANA_CLIENT_SECRET repo Secret); the two spellings are deliberate,
# not a duplicate. Kamal injects each name into the container verbatim, api
# reads the OAUTH_* one and Grafana only reads GF_-prefixed env vars, so one
# shared spelling would leave Grafana without a client secret (issue #1517).
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=$GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET
GF_SECURITY_ADMIN_PASSWORD=$GF_SECURITY_ADMIN_PASSWORD
GF_SMTP_PASSWORD=$GF_SMTP_PASSWORD
GF_SMTP_FROM_ADDRESS=$GF_SMTP_FROM_ADDRESS
# GitHub + Sentry datasource plugin tokens (issue #1570), read by $__env{}
# in infra/grafana/provisioning/datasources/issue-signals.yml.
GRAFANA_GITHUB_DATASOURCE_TOKEN=$GRAFANA_GITHUB_DATASOURCE_TOKEN
GRAFANA_SENTRY_DATASOURCE_TOKEN=$GRAFANA_SENTRY_DATASOURCE_TOKEN
# Slack Incoming Webhook URL (issue #1592), read by $__env{} in
# infra/grafana/provisioning/alerting/contactpoints.yml — replaces the
# NOTIFY_EMAIL_TO-based email alert contact point.
GRAFANA_SLACK_WEBHOOK_URL=$GRAFANA_SLACK_WEBHOOK_URL
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
STEAM_API_KEY=$STEAM_API_KEY
HARDCOVER_API_KEY=$HARDCOVER_API_KEY
BMC_PARTNER_KEY=$BMC_PARTNER_KEY
R2_ACCOUNT_ID=$R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
R2_BUCKET=$R2_BUCKET
SENTRY_DSN=$SENTRY_DSN
SENTRY_DSN_WEB=$SENTRY_DSN_WEB
GITHUB_OAUTH_CLIENT_ID=$GITHUB_OAUTH_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=$GITHUB_OAUTH_CLIENT_SECRET
SENTRY_OAUTH_CLIENT_ID=$SENTRY_OAUTH_CLIENT_ID
SENTRY_OAUTH_CLIENT_SECRET=$SENTRY_OAUTH_CLIENT_SECRET
DO_OAUTH_CLIENT_ID=$DO_OAUTH_CLIENT_ID
DO_OAUTH_CLIENT_SECRET=$DO_OAUTH_CLIENT_SECRET
TODOIST_OAUTH_CLIENT_ID=$TODOIST_OAUTH_CLIENT_ID
TODOIST_OAUTH_CLIENT_SECRET=$TODOIST_OAUTH_CLIENT_SECRET
ENCRYPTION_KEY=$ENCRYPTION_KEY
RESEND_API_KEY=$RESEND_API_KEY
EMAIL_FROM=$EMAIL_FROM
NOTIFY_EMAIL_TO=$NOTIFY_EMAIL_TO
EMAIL_INBOUND_DOMAIN=$EMAIL_INBOUND_DOMAIN
EMAIL_INBOUND_SECRET=$EMAIL_INBOUND_SECRET
OBSERVABILITY_INGEST_SECRET=$OBSERVABILITY_INGEST_SECRET
# Consumed by the api container too (issue #1564): the get_grafana_alerts
# MCP tool authenticates to Grafana's API as `admin` with this. Same value
# and repo Secret as the grafana service's GF_SECURITY_ADMIN_PASSWORD above.
GRAFANA_ADMIN_PASSWORD=$GRAFANA_ADMIN_PASSWORD

# No accessory secrets here — Postgres stays entirely OpenTofu-managed
# (infra/postgres-compose.yml); DB_DSN above is the only bridge to it. Its
# own secret (POSTGRES_PASSWORD) lives solely in the VPS's
# /home/deploy/postgres/.env, not here. (DB_DSN's own value is a repo
# Secret, KAMAL_DB_DSN, copied once from `tofu output -raw
# postgres_password` — see the template's comment.) GoTrue used to have its
# own accessory secrets here too until issue #1039 replaced it with
# first-party auth (JWT_SECRET/OAUTH_HMAC_SECRET above) and removed the
# container from infra/ entirely.
