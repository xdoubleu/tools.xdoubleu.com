# The job image (docs/adr-0043). Build on the Mac: `make image`. It has no registry
# access when a job runs, so everything a job needs is installed here. Base images and
# CLIs are pinned; the plugin marketplaces are not (they track their default branch),
# so a rebuild picks up their current skills. Runs as the unprivileged `node` user (uid 1000).
FROM docker.io/library/golang:1.27.4@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS go

FROM docker.io/library/node:26-bookworm-slim@sha256:5df79989ed685e09f0a98019db4cebfb22fb9df1a53c0161664a011f7ff6b0f1

ARG CLAUDE_CODE_VERSION=2.1.285
# Only @opencode/cli: the `opencode-ai` package ships the same binary name.
ARG OPENCODE_VERSION=2.2.2
# Go tools and sqlfluff come from tools/ci-tools.txt, the pins CI uses too
# (make lint/ci-tools); Playwright keeps step with web/package.json.
ARG PLAYWRIGHT_VERSION=1.65.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq make postgresql postgresql-client python3 python3-venv \
        ruby xz-utils \
    && rm -rf /var/lib/apt/lists/*

# bookworm has no apt bundler; `bundle update` needs it (gems come through the proxy).
RUN gem install --no-document bundler -v 2.4.22

# sqlfluff for `make lint/sql` and `make lint/migrations`; Chromium and its OS
# libraries for mobile-review (root-owned, world-readable, as the job user is not root).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
COPY tools/ci-tools.txt tools/setup-ci-tools.sh /opt/ci-tools/
RUN python3 -m venv /opt/sqlfluff \
    && PIP=/opt/sqlfluff/bin/pip /opt/ci-tools/setup-ci-tools.sh pip \
    && ln -s /opt/sqlfluff/bin/sqlfluff /usr/local/bin/sqlfluff \
    && npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && chmod -R a+rX /opt/ms-playwright \
    && rm -rf /var/lib/apt/lists/* /root/.npm

COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/home/node/go/bin:$PATH

RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm install -g "@opencode/cli@${OPENCODE_VERSION}"

# Claude's config (marketplaces and the plugins .claude/settings.json enables) lives
# here; the runner copies it into a new session directory, because CLAUDE_CONFIG_DIR
# replaces the whole config directory.
RUN mkdir -m 0755 /nix /etc/nix \
    && echo 'experimental-features = nix-command flakes' > /etc/nix/nix.conf \
    && chown node:node /nix \
    && mkdir -p /opt/claude-config /opt/gomodcache /opt/npmcache /deps \
    && chown node:node /opt/claude-config /opt/gomodcache /opt/npmcache /deps
USER node
ENV CLAUDE_CONFIG_DIR=/opt/claude-config
RUN claude plugin marketplace add xdoubleu/skills \
    && claude plugin marketplace add anthropics/claude-plugins-official \
    && claude plugin marketplace add mattpocock/skills \
    && for p in git-task-flow session-retro git-cleanup github-issue-triage \
        skill-lifecycle; do claude plugin install "$p@xdoubleu-skills"; done \
    && claude plugin install claude-md-management@claude-plugins-official \
    && claude plugin install mattpocock-skills@mattpocock
# Nix (single-user, /nix owned by the job user) for the flake dev shell (docs/adr-0054).
ARG NIX_VERSION=2.24.10
ARG TARGETARCH
RUN case "${TARGETARCH}" in amd64) a=x86_64 ;; arm64) a=aarch64 ;; *) exit 1 ;; esac \
    && d="nix-${NIX_VERSION}-${a}-linux" \
    && curl -fsSL -o "/tmp/${d}.tar.xz" "https://releases.nixos.org/nix/nix-${NIX_VERSION}/${d}.tar.xz" \
    && tar -xJf "/tmp/${d}.tar.xz" -C /tmp \
    && "/tmp/${d}/install" --no-daemon \
    && rm -rf /tmp/nix-*

# The flake's dev shell (flake.nix), realised here so a job's toolchain is the one
# CI and local dev use (docs/adr-0054). The profile is the GC root that keeps it
# through the prune; the cap fails the build rather than grow the image unbounded.
ENV PATH=/home/node/.nix-profile/bin:$PATH
COPY --chown=node:node flake.nix flake.lock /opt/flake/
ARG NIX_STORE_MAX=3221225472
RUN case "${TARGETARCH}" in amd64) s=x86_64-linux ;; arm64) s=aarch64-linux ;; *) exit 1 ;; esac \
    && nix build --out-link /nix/var/nix/profiles/devshell "/opt/flake#packages.${s}.default" \
    && nix store gc \
    && size=$(du -sb /nix/store | cut -f1) \
    && if [ "$size" -gt "$NIX_STORE_MAX" ]; then \
        echo "nix store is $size bytes, over the $NIX_STORE_MAX cap" >&2; exit 1; \
    fi
# Tools go through the module cache the VM uses as its file:// GOPROXY, so the
# Makefile's own `go install tool@version` resolves offline. GOTOOLCHAIN=local keeps
# Go at the image's version (api/go.mod's).
ENV GOMODCACHE=/opt/gomodcache GOTOOLCHAIN=local
RUN /opt/ci-tools/setup-ci-tools.sh go

# Dependency caches for the offline VM (docs/adr-0043): every Go module's downloads
# (used as a file:// GOPROXY) and web/'s npm cache, so lint and tests run on a fresh
# clone. What changed since the build resolves through the egress proxy's read-only
# registry routes. Build from the repo root: `make image`.
COPY --chown=node:node selfupdate/go.mod selfupdate/go.sum* /deps/selfupdate/
COPY --chown=node:node wardcase/go.mod wardcase/go.sum /deps/wardcase/
COPY --chown=node:node api/go.mod api/go.sum /deps/api/
COPY --chown=node:node factory-runner/go.mod factory-runner/go.sum /deps/factory-runner/
COPY --chown=node:node kobo-gateway/go.mod kobo-gateway/go.sum /deps/kobo-gateway/
COPY --chown=node:node web/package.json web/package-lock.json /deps/web/
RUN for m in api factory-runner kobo-gateway selfupdate wardcase; do \
        (cd /deps/$m && go mod download) || exit 1; \
    done \
    && (cd /deps/web && npm ci --ignore-scripts --no-audit --no-fund \
        --cache /opt/npmcache) \
    && rm -rf /deps/* \
    && chmod -R a+rX /opt/gomodcache /opt/npmcache \
    && rm -rf /home/node/.cache/go-build

WORKDIR /work
