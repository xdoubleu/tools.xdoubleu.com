# Pins the Kamal gem (issue #1036) — Kamal has no Go/Node distribution, it
# ships as a Ruby gem. The only Kamal in the repo: CI runs
# `bundle exec kamal` (.github/workflows/main.yml's deploy-kamal job), and so
# should you for a manual deploy, so both use the same pinned version.
source "https://rubygems.org"

gem "kamal"
