# Copy to terraform.tfvars (gitignored) and fill in real values, then run
# `tofu plan`/`tofu apply` with no -var flags needed.

hcloud_token           = ""
server_id              = ""
server_ip              = ""
deploy_ssh_public_key  = ""

# GoTrue (issue #1032) — see README.md's "Stand up GoTrue" section.
gotrue_jwt_secret       = ""
resend_api_key          = ""
gotrue_site_url         = ""
gotrue_smtp_admin_email = ""

# App secrets for the Kamal deploy (issue #1033) — same values as
# do-app.yaml's SECRET list (today's DO App Platform deploy). See
# README.md's "Deploy the app via Kamal" section.
# kamal_registry_username/kamal_registry_password: required by Kamal's own
# config schema even though the image is a public GHCR package — see the
# comment above these two in infra/variables.tf.
kamal_registry_username     = ""
kamal_registry_password     = ""
# supabase_proj_ref/supabase_url/supabase_anon_key/supabase_api_key can be
# dummy values if Supabase isn't in use at all — see the comment above
# these four in infra/variables.tf for why (MCP OAuth sign-in only).
supabase_proj_ref          = ""
supabase_api_key           = ""
steam_api_key              = ""
hardcover_api_key          = ""
r2_account_id               = ""
r2_access_key_id            = ""
r2_secret_access_key        = ""
r2_bucket                   = ""
sentry_dsn                  = ""
sentry_dsn_web              = ""
supabase_url                = ""
supabase_anon_key           = ""
github_oauth_client_id      = ""
github_oauth_client_secret  = ""
sentry_oauth_client_id      = ""
sentry_oauth_client_secret  = ""
do_oauth_client_id          = ""
do_oauth_client_secret      = ""
encryption_key               = ""
email_from                   = ""
notify_email_to              = ""
email_inbound_domain         = ""
email_inbound_secret         = ""
