# Rendered into config/deploy.yml (gitignored) by two independent paths that
# share this one template — do not edit config/deploy.yml directly:
#   - Locally: `tofu apply` (infra/main.tf's local_file.kamal_deploy_config,
#     via Terraform's templatefile()), for one-off/manual deploys.
#   - CI: .github/workflows/main.yml's deploy-kamal job, via `envsubst` (this
#     template's only interpolations, $${server_ip}/$${ghcr_username}, use
#     plain shell-compatible syntax, so both tools render it identically —
#     confirmed byte-for-byte via `tofu console`).
#
# Kamal deploy config for issue #1033/#1036 — deploys the merged `app` image
# to the Hetzner VPS (infra/), over its raw IP.
#
# Deliberately raw-IP only: `proxy.host` (the real domain) isn't set, since
# kamal-proxy's automatic Let's Encrypt issuance needs DNS already pointing at
# this box, which hasn't happened yet (that's the Cutover issue, #1034).
#
# Postgres and GoTrue stay exactly as OpenTofu already manages them
# (infra/postgres-compose.yml, issues #1031/#1032) — plain docker-compose
# containers, no Kamal accessories here. Both are bound to 127.0.0.1 only on
# the host (never exposed publicly) and reachable from the Kamal-deployed app
# container by joining the same `kamal` Docker network (created by
# null_resource.kamal_network in infra/main.tf before Postgres/GoTrue come
# up, since postgres-compose.yml declares it `external: true`) — DB_DSN/
# GOTRUE_URL below use the container names (`postgres`/`gotrue`) as
# hostnames, exactly like GOTRUE_DB_DATABASE_URL already does internally.

service: tools-xdoubleu-com
# No `ghcr.io/` prefix here — registry.server below already supplies it.
# Kamal concatenates registry.server + image itself; including it in both
# places doubles up into ghcr.io/ghcr.io/... (confirmed via `kamal config`).
image: xdoubleu/tools.xdoubleu.com/app

servers:
  web:
    hosts:
      - ${server_ip}
    labels:
      # No proxy.host/TLS yet — reach the app over the raw IP/port during
      # this validation deploy.
      traefik.enable: "false"

# No ssh.key_data here — both deploy paths authenticate via ssh-agent
# instead (the operator's own agent locally; .github/workflows/main.yml's
# deploy-kamal CI job loads KAMAL_SSH_KEY into a real agent via
# webfactory/ssh-agent), so this one shared template needs no per-path
# branching for SSH auth.
ssh:
  user: deploy

# Required even though ghcr.io/xdoubleu/tools.xdoubleu.com/app is a public
# package (no docker login needed to actually pull it) — Kamal's own config
# schema unconditionally requires registry.username/password, confirmed via
# `kamal config` erroring without them regardless of image visibility. A
# GHCR PAT with read:packages works fine even against a public package.
registry:
  server: ghcr.io
  username: ${ghcr_username}
  password:
    - KAMAL_REGISTRY_PASSWORD

# Hetzner CX22/23 is x86_64 — also required by Kamal's config schema, unused
# in practice since every deploy here passes --skip-push (image is already
# built and pushed by CI, see infra/main.tf/#1036's CI workflow).
builder:
  arch:
    - amd64

proxy:
  app_port: 8000
  healthcheck:
    path: /health
    interval: 10
    timeout: 5

env:
  clear:
    ENV: production
    WEB_URL: http://${server_ip}
    API_URL: http://${server_ip}/api
    GOMEMLIMIT: 300MiB
  secret:
    # Deploy-time SHA — DO App Platform used to inject this itself; Kamal
    # doesn't. Set by whichever path is deploying: null_resource.kamal_deploy
    # (current git HEAD) locally, or the deploy-kamal CI job (github.sha)
    # remotely. Feeds Sentry release tagging and web/components/Footer.tsx's
    # version display (forwarded to the web child by
    # gateway/internal/gateway/children.go).
    - RELEASE
    # postgres://postgres:<password>@postgres:5432/postgres — same
    # OpenTofu-managed Postgres from infra/postgres-compose.yml, reached
    # over the shared `kamal` Docker network (see file header), not
    # Supabase. Set locally from random_password.postgres.result; CI has no
    # access to local Tofu state, so it comes from a KAMAL_DB_DSN repo
    # secret there instead (same value, `tofu output -raw postgres_password`
    # copied in once).
    - DB_DSN
    # http://gotrue:9999 — same network. Makes api/cmd/api/main.go call
    # WithCustomAuthURL, pointing sign-in at self-hosted GoTrue instead of
    # Supabase-hosted GoTrue. Static, not a secret — hardcoded by both
    # deploy paths.
    # SUPABASE_PROJ_REF/SUPABASE_URL/SUPABASE_ANON_KEY/SUPABASE_API_KEY stay
    # set too but are otherwise unused once this is set — they only ever
    # mattered for the MCP OAuth authorization-server issuer
    # (api/cmd/api/mcp.go), a deliberate exception that stays pointed at
    # Supabase per #1032's own scoping note. If Supabase isn't in use at
    # all, dummy values are fine (see infra/variables.tf's comment) — MCP
    # sign-in just stays broken until the future "retire GoTrue entirely"
    # issue (#1039) replaces that flow properly.
    - GOTRUE_URL
    # Everything below is a sensitive tfvar (infra/variables.tf), set in
    # terraform.tfvars same as gotrue_jwt_secret/resend_api_key above — same
    # values as do-app.yaml's SECRET list (today's DO App Platform deploy).
    - SUPABASE_PROJ_REF
    - SUPABASE_API_KEY
    - STEAM_API_KEY
    - HARDCOVER_API_KEY
    - R2_ACCOUNT_ID
    - R2_ACCESS_KEY_ID
    - R2_SECRET_ACCESS_KEY
    - R2_BUCKET
    - SENTRY_DSN
    - SENTRY_DSN_WEB
    - SUPABASE_URL
    - SUPABASE_ANON_KEY
    - GITHUB_OAUTH_CLIENT_ID
    - GITHUB_OAUTH_CLIENT_SECRET
    - SENTRY_OAUTH_CLIENT_ID
    - SENTRY_OAUTH_CLIENT_SECRET
    - DO_OAUTH_CLIENT_ID
    - DO_OAUTH_CLIENT_SECRET
    - ENCRYPTION_KEY
    - RESEND_API_KEY
    - EMAIL_FROM
    - NOTIFY_EMAIL_TO
    - EMAIL_INBOUND_DOMAIN
    - EMAIL_INBOUND_SECRET
