# Generated by `tofu apply` (infra/main.tf's local_file.kamal_deploy_config,
# rendered from this file) — do not edit config/deploy.yml directly, edit
# this template instead and re-run `tofu apply`.
#
# Kamal deploy config for issue #1033 — one real deploy of the merged `app`
# image on the Hetzner VPS (infra/), over its raw IP. Driven entirely by
# `tofu apply` (infra/main.tf's null_resource.kamal_deploy shells out to
# `kamal setup` locally) — not wired into CI here (that's #1036).
#
# Deliberately raw-IP only: `proxy.host` (the real domain) isn't set, since
# kamal-proxy's automatic Let's Encrypt issuance needs DNS already pointing at
# this box, which hasn't happened yet (that's the Cutover issue, #1034).
#
# Postgres and GoTrue stay exactly as OpenTofu already manages them
# (infra/postgres-compose.yml, issues #1031/#1032) — plain docker-compose
# containers, no Kamal accessories here. Both are bound to 127.0.0.1 only on
# the host (never exposed publicly) and reachable from the Kamal-deployed app
# container by joining the same `kamal` Docker network (created by
# null_resource.kamal_network in infra/main.tf before Postgres/GoTrue come
# up, since postgres-compose.yml declares it `external: true`) — DB_DSN/
# GOTRUE_URL below use the container names (`postgres`/`gotrue`) as
# hostnames, exactly like GOTRUE_DB_DATABASE_URL already does internally.

service: tools-xdoubleu-com
image: ghcr.io/xdoubleu/tools.xdoubleu.com/app

servers:
  web:
    hosts:
      - ${server_ip}
    labels:
      # No proxy.host/TLS yet — reach the app over the raw IP/port during
      # this validation deploy.
      traefik.enable: "false"

ssh:
  user: deploy

registry:
  server: ghcr.io
  username: ${ghcr_username}
  password:
    - KAMAL_REGISTRY_PASSWORD

proxy:
  app_port: 8000
  healthcheck:
    path: /health
    interval: 10
    timeout: 5

env:
  clear:
    ENV: production
    WEB_URL: http://${server_ip}
    API_URL: http://${server_ip}/api
    GOMEMLIMIT: 300MiB
  secret:
    # Deploy-time SHA — DO App Platform used to inject this itself; Kamal
    # doesn't, so infra/main.tf's null_resource.kamal_deploy sets it
    # explicitly (current git HEAD) on every `tofu apply`. Feeds Sentry
    # release tagging and web/components/Footer.tsx's version display
    # (forwarded to the web child by gateway/internal/gateway/children.go).
    - RELEASE
    # postgres://postgres:<random_password.postgres.result>@postgres:5432/postgres
    # — set by null_resource.kamal_deploy, not exported by hand. The same
    # OpenTofu-managed Postgres from infra/postgres-compose.yml, reached
    # over the shared `kamal` Docker network (see file header), not
    # Supabase.
    - DB_DSN
    # http://gotrue:9999 — same network, also set by null_resource.kamal_deploy.
    # Makes api/cmd/api/main.go call WithCustomAuthURL, pointing sign-in at
    # self-hosted GoTrue instead of Supabase-hosted GoTrue.
    # SUPABASE_PROJ_REF/SUPABASE_API_KEY stay set too (auth-go still wants
    # non-empty values) but are otherwise unused once this is set; the MCP
    # OAuth authorization-server issuer (api/cmd/api/mcp.go) is a deliberate
    # exception that stays pointed at Supabase — see #1032's own scoping
    # note, closed properly by the future "retire GoTrue entirely" issue
    # (#1039), not here.
    - GOTRUE_URL
    # Everything below is exported by hand in the shell running `tofu
    # apply` (same convention as HCLOUD_TOKEN) — infra/README.md's "Deploy
    # the app via Kamal" section lists the full set, same values as
    # do-app.yaml's SECRET list (today's DO App Platform deploy).
    - SUPABASE_PROJ_REF
    - SUPABASE_API_KEY
    - STEAM_API_KEY
    - HARDCOVER_API_KEY
    - R2_ACCOUNT_ID
    - R2_ACCESS_KEY_ID
    - R2_SECRET_ACCESS_KEY
    - R2_BUCKET
    - SENTRY_DSN
    - SENTRY_DSN_WEB
    - SUPABASE_URL
    - SUPABASE_ANON_KEY
    - GITHUB_OAUTH_CLIENT_ID
    - GITHUB_OAUTH_CLIENT_SECRET
    - SENTRY_OAUTH_CLIENT_ID
    - SENTRY_OAUTH_CLIENT_SECRET
    - DO_OAUTH_CLIENT_ID
    - DO_OAUTH_CLIENT_SECRET
    - ENCRYPTION_KEY
    - RESEND_API_KEY
    - EMAIL_FROM
    - NOTIFY_EMAIL_TO
    - EMAIL_INBOUND_DOMAIN
    - EMAIL_INBOUND_SECRET
