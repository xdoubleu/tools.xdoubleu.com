      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-sentry-datasource", "uid": "sentry" },
          "queryType": "issues",
          "issuesQuery": "is:unresolved",
          "issuesLimit": 1000,
          "projectIds": [],
          "environments": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["count"], "fields": "" }, "colorMode": "background", "graphMode": "none" }
    }
  ]
