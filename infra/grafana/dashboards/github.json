{
  "uid": "github-signals",
  "title": "GitHub",
  "tags": ["provisioned"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Failing pull requests",
      "description": "github_failing_pull_requests gauge from the issue-signal collector (#1539). Aggregated with `max(...)` because the gauge is exported by the api process, which gets a fresh docker_sd `instance` label every Kamal deploy (infra/prometheus.yml) — without it, every redeploy added a permanent extra line to the timeseries panels below (issue #1580).",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(github_failing_pull_requests)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Main CI red",
      "description": "Mirrors the IssueMainCIRed alert rule exactly.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(github_workflow_run_failed{branch=\"main\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open security alerts by severity",
      "description": "github_open_security_alerts gauge from the issue-signal collector (#1539). Aggregated with `max by (severity)` for the same per-deploy-churn reason as panel 1.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{severity}}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (severity) (github_open_security_alerts)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Failed workflow runs by branch",
      "description": "github_workflow_run_failed gauge from the issue-signal collector (#1539). Aggregated with `max by (branch)` — this panel is the one the per-deploy churn bug (#1580) was originally reported against: a bare `github_workflow_run_failed` carries the scraping api container's `instance` label, so every redeploy left a dead extra line on this chart forever.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{branch}}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (branch) (github_workflow_run_failed)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CI workflow run duration",
      "description": "Duration of the most recent completed run of each GitHub Actions workflow on the default branch. Refreshed every 5 minutes by IssueSignalCollectorJob, not scraped from GitHub directly. Aggregated with `max by (workflow)` for the same per-deploy-churn reason as the panel above.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{workflow}}", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max by (workflow) (github_workflow_run_duration_seconds)" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
