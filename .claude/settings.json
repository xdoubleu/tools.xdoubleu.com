{
  "model": "sonnet",
  "autoMemoryEnabled": false,
  "extraKnownMarketplaces": {
    "xdoubleu-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "xdoubleu/xdoubleu-claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "git-task-flow@xdoubleu-claude-plugins": true,
    "session-retro@xdoubleu-claude-plugins": true,
    "git-cleanup@xdoubleu-claude-plugins": true,
    "github-issue-triage@xdoubleu-claude-plugins": true,
    "skill-lifecycle@xdoubleu-claude-plugins": true
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(go test *)",
      "Bash(npm run test:cov *)",
      "Bash(ast-grep run *)",
      "Bash(make test/cov/report)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(npm run lint *)",
      "Bash(go tool cover *)",
      "Bash(make lint)",
      "Bash(make lint *)",
      "Bash(npm run test:single *)",
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(gh project list *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(/usr/bin/log show *)",
      "Bash(docker-compose up -d*)",
      "Bash(docker-compose down*)",
      "Bash(docker-compose ps*)",
      "Bash(make lint/pkg *)",
      "Bash(make pdf/check)",
      "Bash(npm run generate)",
      "Bash(git fetch origin main)",
      "Bash(git fetch origin main *)",
      "Bash(curl -s \"https://api.codecov.io/*\")",
      "mcp__tools-apps__get_deploy_logs",
      "mcp__tools-apps__get_deploy_status",
      "mcp__tools-apps__reading_list_feeds"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); if echo \"$cmd\" | grep -Eq '(^|[^a-zA-Z])(grep|rg)([^a-zA-Z]|$)' && ! echo \"$cmd\" | grep -q 'ast-grep'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"REMINDER: CLAUDE.md rule - prefer ast-grep over grep/rg for code searches. Only use grep/rg for non-code files (logs, configs, docs).\"}}'; fi",
            "statusMessage": "Checking for grep/rg usage..."
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"REMINDER: CLAUDE.md rule - prefer ast-grep for code searches. Only use the Grep tool for non-code files (logs, configs, docs).\"}}'",
            "statusMessage": "Reminding to prefer ast-grep..."
          }
        ]
      }
    ]
  }
}
