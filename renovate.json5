{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    // Third-party actions run with deploy/infra secrets; pin them to digests.
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
  ],
  // The api module's local `replace`; there is nothing to look up.
  ignoreDeps: [
    'tools.xdoubleu.com/sentrytools',
  ],
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)[^/]*-compose\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+version: (?<currentValue>v[^\\s]+)',
      ],
    },
    // Unprefixed `<name>_version:` / `<NAME>_VERSION:` keys (tofu_version,
    // OPENCODE_VERSION); tags may carry a `v`.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.yml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+[A-Za-z]+_(?:version|VERSION): (?<currentValue>[^\\s]+)',
      ],
      extractVersionTemplate: '^v?(?<version>.+)$',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Makefile$/',
      ],
      matchStrings: [
        'go install (?<depName>[^@]+)@(?<currentValue>[0-9a-zA-Z.]+)',
      ],
      datasourceTemplate: 'go',
    },
    // codecov-cli, sqlfluff (and sqlfluff's pip cache key).
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.*\\.yml$/',
        '/Makefile$/',
      ],
      matchStrings: [
        'pip install (?:-[^\\s]+ )*(?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[^\\s]+)',
        'key: (?<depName>sqlfluff)-(?<currentValue>[^\\s]+)',
      ],
      datasourceTemplate: 'pypi',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)go\\.mod$/',
      ],
      matchStrings: [
        '\\sgo (?<currentValue>.+?)\\s',
      ],
      depNameTemplate: 'golang',
      datasourceTemplate: 'docker',
    },
    // promtool's image, kept in step with infra/prometheus-compose.yml.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts/lint_infra\\.sh$/',
      ],
      matchStrings: [
        'prom_image="(?<depName>[^:"]+):(?<currentValue>[^"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"',
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/buf\\.gen\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+- remote: [^:]+:(?<currentValue>v[^\\s]+)',
      ],
    },
    // Grafana plugin versions baked into the wrapper image.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^infra/grafana\\.Dockerfile$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z_]+_VERSION=(?<currentValue>[^\\s]+)',
      ],
    },
  ],
  // `custom.grafana-plugin`: grafana.com's plugin catalog. createdAt feeds
  // minimumReleaseAge.
  customDatasources: {
    'grafana-plugin': {
      defaultRegistryUrlTemplate: 'https://grafana.com/api/plugins/{{packageName}}/versions',
      transformTemplates: [
        '{"releases": items.{"version": version, "releaseTimestamp": createdAt}}',
      ],
    },
  },
  packageRules: [
    {
      groupName: 'golangci-lint',
      matchDepNames: [
        'github.com/golangci/golangci-lint/v2/cmd/golangci-lint',
        'golangci/golangci-lint',
      ],
    },
    {
      groupName: 'proto',
      matchDepNames: [
        '@bufbuild/protobuf',
        '@bufbuild/protoc-gen-es',
        'bufbuild/protobuf-es',
      ],
    },
    {
      groupName: 'proto',
      matchDepNames: [
        '@connectrpc/connect',
        '@connectrpc/connect-web',
      ],
    },
    {
      groupName: 'proto',
      matchDepNames: [
        'google.golang.org/protobuf',
        'google.golang.org/protobuf/cmd/protoc-gen-go',
        'protocolbuffers/protobuf-go',
      ],
    },
    {
      groupName: 'proto',
      matchDepNames: [
        'connectrpc.com/connect',
        'connectrpc.com/connect/v2',
        'connectrpc.com/connect/v2/cmd/protoc-gen-connect-go',
        'connectrpc/connect-go',
      ],
    },
    // Major codegen bumps regenerate api/gen differently, so the proto staleness
    // check can never pass until the code is migrated; a human decides when.
    {
      matchDepNames: [
        'connectrpc.com/connect',
        'connectrpc/connect-go',
        'buf.build/connectrpc/go',
        'protocolbuffers/protobuf-go',
        'bufbuild/protobuf-es',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    {
      groupName: 'typescript',
      matchDepNames: [
        'typescript',
        'typescript-eslint',
        '@typescript-eslint/eslint-plugin',
        '@typescript-eslint/parser',
      ],
    },
    // A package path, not a module, so its own lookup finds nothing; resolving
    // the module keeps it in the proto group with go.mod and buf.gen.yaml.
    {
      matchDepNames: [
        'connectrpc.com/connect/v2/cmd/protoc-gen-connect-go',
      ],
      overridePackageName: 'connectrpc.com/connect/v2',
    },
    // Regex matches without a captured digest have nowhere to put one.
    {
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'docker',
      ],
      pinDigests: false,
    },
    // golang images set GOTOOLCHAIN=local, so a go directive above the builder
    // image's Go fails the Docker build.
    {
      groupName: 'golang',
      matchDatasources: [
        'docker',
      ],
      matchDepNames: [
        'golang',
      ],
    },
    // A major needs a pg_upgrade of the production volume (and PG18 moves the
    // mount to /var/lib/postgresql); CI and dev move with production.
    {
      matchDatasources: [
        'docker',
      ],
      matchDepNames: [
        'postgres',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: true,
    },
    // Merging restarts production Postgres through infra-apply.
    {
      matchFileNames: [
        'infra/postgres-compose.yml',
      ],
      automerge: false,
    },
    // Only deploy-kamal, on main, runs setup-ruby, so no PR check catches a
    // ruby-version it doesn't know yet. By the time a Ruby is a week old, a
    // setup-ruby that knows it is past the 3-day minimum; both land together.
    {
      groupName: 'ruby',
      matchDepNames: [
        'ruby',
        'ruby/setup-ruby',
      ],
      schedule: [
        '* 0-3 * * 1',
      ],
    },
    {
      matchDepNames: [
        'ruby',
      ],
      minimumReleaseAge: '7 days',
    },
    // No PR check runs OpenCode.
    {
      matchDepNames: [
        '@opencode/cli',
      ],
      automerge: false,
    },
    // An override forces a version onto packages that didn't ask for it.
    {
      matchManagers: [
        'npm',
      ],
      matchDepTypes: [
        'overrides',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },
  ],
  timezone: 'Europe/Brussels',
  labels: [
    'dependencies',
  ],
  dependencyDashboardLabels: [
    'dependencies',
  ],
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  constraintsFiltering: 'strict',
  // Only rebase on actual conflicts, not every time main moves — avoids
  // re-triggering CI (and a stale-failure email) on every unrelated merge (#1016)
  rebaseWhen: 'conflicted',
  automerge: true,
  automergeType: 'pr',
  platformAutomerge: true,
}
